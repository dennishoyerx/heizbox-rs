+
+#[derive(Error, Debug)]
+pub enum DeviceError {
+    #[error("Device not ready")]
+    NotReady,
+    #[error("Device error: {0}")]
+    Other(String),
+}
+
+#[async_trait]
+pub trait Device {
+    async fn status(&self) -> Result<(), DeviceError>;
+}
diff --git a/crates/heizbox-core/src/error.rs b/crates/heizbox-core/src/error.rs
